# Copy to ai-service/.env (never commit .env)

# echo = Phase 1 bridge test | claude = Phase 2+ (requires ANTHROPIC_API_KEY)
AI_COACH_MODE=echo

# Must match backend-node AI_INTERNAL_KEY
AI_INTERNAL_KEY=taqwin-dev-internal-change-me

# Node internal API (Phase 4+ tools — not used in Phase 0–1)
NODE_INTERNAL_API_URL=http://127.0.0.1:4002

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional vector DB path (Phase 3+)
# CHROMA_PATH=./data/chroma
