# Taqwin AI service (Block A2 skeleton — keys used in A3+)
LOG_LEVEL=info

# Shared secret with backend-node (Block A4 internal API)
AI_INTERNAL_KEY=change-me-long-random-secret

# Node monolith (tools, RAG search, plan persistence) — must match backend-node AI_INTERNAL_KEY
NODE_INTERNAL_API_URL=http://localhost:4000
AI_INTERNAL_KEY=change-me-long-random-secret
NODE_INTERNAL_TIMEOUT_SECONDS=30

# Block B6 retriever — lower = cheaper coach prompts (see COST section below)
RAG_LIMIT_PER_LEVEL=4
RAG_MAX_TOTAL_CHUNKS=10
RAG_PHILOSOPHY_LIMIT=3
COACH_ALWAYS_L5=false
RAG_RERANK_FETCH_K=15
RAG_MIN_SCORE=0
RAG_MIN_SCORE_L1=0.28
RAG_MIN_SCORE_L2=0.35
RAG_MIN_SCORE_L3=0.35
RAG_MIN_SCORE_L5=0.25
RAG_MIN_SCORE_L5_LIGHT=0.32
RAG_L5_LIGHT_LIMIT=2
RAG_L5_SKIP_WHEN_CATALOG_SCORE=0.42
RAG_PLATFORM_L1_ONLY_CONFIDENCE=0.55

# Tier 2 — hybrid fetch + cross-encoder reranking
RAG_RERANK_ENABLED=true
RAG_RERANK_PROVIDER=cohere
# RAG_RERANK_FETCH_K=15
RAG_RERANK_KEEP_PER_LEVEL=6
# COHERE_API_KEY=
# COHERE_RERANK_MODEL=rerank-v3.5
# VOYAGE_API_KEY=
# VOYAGE_RERANK_MODEL=rerank-2
# LOCAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Coach step-up (prompt copy only — enforcement in backend-node stepUpAuth.js)
# Must match backend-node when overriding idle timing (shared/coach-step-up.json is fallback).
# STEP_UP_IDLE_MS=300000                # stale pending threshold for coach confirmation prompts
# STEP_UP_MAX_FAILS=5
# STEP_UP_LOCKOUT_MS=900000

# LLM — required for chat, plan, memory summarize (Node has no direct LLM calls)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=768
PLAN_LLM_TEMPERATURE=0.2
PLAN_LLM_MAX_TOKENS=6000
PLAN_LLM_INTERNAL_ATTEMPTS=1
PLAN_TIMEOUT_SECONDS=120
# Cost savers — auxiliary classifiers use Haiku; rules cover most intents without LLM
INTENT_LLM_FALLBACK=false
INTENT_LLM_MIN_CONFIDENCE=0.55
INTENT_LLM_TIMEOUT_SECONDS=15
COACH_MAX_TOOL_LOOPS=2
COACH_SUMMARIZE_AFTER_TOOLS=false
COACH_HISTORY_MAX_MESSAGES=10
PROMPT_CACHE_ENABLED=true

MEAL_VISION_MODEL=claude-sonnet-4-5
MEAL_VISION_MAX_TOKENS=2048

# Data stores (Block A5+)
MONGODB_URI=
MONGODB_DB=taqwin_ai
REDIS_URL=

# Embeddings (Block B+)
EMBEDDING_MODEL=text-embedding-3-small
