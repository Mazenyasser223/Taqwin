# Copy to .env.local for local overrides. Never commit .env or .env.local.

# Backend API base URL (no trailing slash)
# Dev: leave unset — Vite proxies /api to the backend (see vite.config.ts).
# Production (Vercel): https://taqwin.onrender.com (also set in frontend/vercel.json)
# VITE_API_URL=https://taqwin.onrender.com

# Sentry frontend errors (same project DSN as backend or a separate browser DSN)
# VITE_SENTRY_DSN=https://...@sentry.io/...
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_APP_VERSION=1.0.0
