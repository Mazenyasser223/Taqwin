# Copy to deploy/.env on the VPS — never commit deploy/.env
# Full variable reference: backend-node/.env.example, ai-service/.env.example

# -----------------------------------------------------------------------------
# Production domain (DNS: @, www, api → VPS IP in Hostinger)
# -----------------------------------------------------------------------------
TAQWIN_DOMAIN=taqwin.online

# -----------------------------------------------------------------------------
# Phase 0.1 — nginx config (switch after TLS in deploy/scripts/issue-tls.sh)
# -----------------------------------------------------------------------------
NGINX_CONF_FILE=./nginx.conf
# After Certbot: NGINX_CONF_FILE=./nginx.https.conf

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# -----------------------------------------------------------------------------
# PostgreSQL (Supabase)
# -----------------------------------------------------------------------------
# Quote URLs when passwords contain &, $, !, or spaces (required if deploy scripts source this file).
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# MongoDB Atlas (chat, traces, AI plans)
# -----------------------------------------------------------------------------
MONGO_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/taqwin?retryWrites=true&w=majority"
MONGO_DB_NAME=taqwin

# -----------------------------------------------------------------------------
# Redis (Upstash TCP — required for BullMQ worker + CAG)
# -----------------------------------------------------------------------------
REDIS_URL="rediss://default:YOUR_PASSWORD@YOUR_DB.upstash.io:6379"

# -----------------------------------------------------------------------------
# Auth + public URLs (Phase 0.2 — must match TLS hostnames)
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-32-plus-char-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://taqwin.online
CORS_ALLOWED_ORIGINS=https://taqwin.online,https://www.taqwin.online
BACKEND_PUBLIC_URL=https://api.taqwin.online
# Used for disk upload URLs + normalizing legacy /uploads paths (defaults to BACKEND_PUBLIC_URL if unset)
API_PUBLIC_URL=https://api.taqwin.online

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://api.taqwin.online/api/auth/google/callback

# -----------------------------------------------------------------------------
# Supabase Storage — required for community photos, videos, stories, avatars
# After deploy: docker compose exec api node scripts/verify-uploads-production.js
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service-role-key
SUPABASE_STORAGE_BUCKET=taqwin-uploads

# -----------------------------------------------------------------------------
# Email — Taqwinfcds.2026@gmail.com (Gmail app password required on VPS)
# Create at: https://myaccount.google.com/apppasswords (2-Step Verification must be on)
# After deploy: npm run verify:email-smtp --prefix backend-node
# -----------------------------------------------------------------------------
GMAIL_USER=Taqwinfcds.2026@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
REQUIRE_EMAIL_VERIFICATION=true
SUPPORT_EMAIL=Taqwinfcds.2026@gmail.com

# -----------------------------------------------------------------------------
# AI stack (FastAPI + Node bridge)
# -----------------------------------------------------------------------------
FEATURE_AI_VIA_FASTAPI=true
AI_SERVICE_URL=http://ai:8000
AI_INTERNAL_KEY=change-me-long-random-secret-min-16-chars
FEATURE_REALTIME_WS=true
FEATURE_PLAN_QUEUE=true

# LLM — used by ai-service container (also pass through Compose env_file)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Embeddings for RAG ingest (Phase 0.4)
OPENAI_API_KEY=sk-...
EMBED_PROVIDER=openai
OPENAI_EMBED_MODEL=text-embedding-3-small
RAG_EMBED_DIMS=1536
RAG_PREFER_PGVECTOR=true

# Optional rerank (Tier 2 RAG)
# COHERE_API_KEY=
# RAG_RERANK_ENABLED=true

# -----------------------------------------------------------------------------
# Observability (Phase 0.8 — rebuild api + worker after setting)
# -----------------------------------------------------------------------------
SENTRY_DSN=https://YOUR_KEY@oYOUR_ORG.ingest.us.sentry.io/YOUR_PROJECT_ID
# SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Production feature flags (defaults — override only when debugging)
# -----------------------------------------------------------------------------
FEATURE_AI_MEMORY_SESSION=true
FEATURE_AI_MEMORY_CRON=true
FEATURE_PLAN_WEEKLY_CRON=true
FEATURE_PLAN_MID_WEEK_CRON=true
FEATURE_SMART_NOTIFY_CRON=true
FEATURE_PLAN_DAILY_CRON=true

# -----------------------------------------------------------------------------
# Paymob (Egypt) — marketplace checkout
# Webhook (Paymob Dashboard → Integration → Transaction processed callback):
#   https://api.taqwin.online/api/marketplace/payments/webhook
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_IFRAME_ID=
# PAYMOB_HMAC_SECRET=

# -----------------------------------------------------------------------------
# Observability (Phase 0.8)
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Frontend (Vercel): VITE_SENTRY_DSN= same or browser DSN
# Uptime: monitor GET /health every 1 min (503 when Postgres down)
#         or GET /health/live for process-only liveness
# Host crontab backup: */5 * * * * cd backend-node && node scripts/uptime-ping.js
# FUNNEL_RATE_LIMIT_MAX=40
# PAYMENTS_CREATE_RATE_LIMIT_MAX=8

# -----------------------------------------------------------------------------
# Telegram Bot — high-value alerts (0–3/day cap)
# Webhook URL: https://api.taqwin.online/api/telegram/webhook/<TELEGRAM_WEBHOOK_SECRET>
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=Taqwin_Ai_Fitness_bot
# TELEGRAM_WEBHOOK_SECRET=random-secret
# TELEGRAM_WEBHOOK_URL=https://api.taqwin.online
# TELEGRAM_APP_URL=https://taqwin.online

# -----------------------------------------------------------------------------
# Certbot (deploy/scripts/issue-tls.sh)
# -----------------------------------------------------------------------------
CERTBOT_EMAIL=you@example.com
