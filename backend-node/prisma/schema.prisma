// ─── AI Coach — Block A0 (plans, progress, RAG, audit) ───────────────────────

enum PlanSource {
  onboarding
  weekly_cron
  adaptation
  manual
}

enum PlanStatus {
  draft
  active
  superseded
  archived
}

enum LifeMode {
  normal
  travel
  sick
  fasting
  injury_flare
}

enum DailyPlanStatus {
  pending
  active
  skipped
  completed
  adapted
}

enum AdaptationDecision {
  keep
  micro
  meso
  macro
}

enum KnowledgeLevel {
  L1_INTERNAL
  L2_EXERCISE
  L3_NUTRITION
  L5_BOOKS
}

