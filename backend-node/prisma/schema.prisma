  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_athlete_plans")
}

model BodyMetric {
  id                   String        @id @default(uuid())
  userId               String        @map("user_id")
  weightKg             Float?        @map("weight_kg")
  bodyFatPct           Float?        @map("body_fat_pct")
  bodyFatMassKg        Float?        @map("body_fat_mass_kg")
  skeletalMuscleMassKg Float?        @map("skeletal_muscle_mass_kg")
  bmi                  Float?
  basalMetabolicRate   Float?        @map("basal_metabolic_rate")
  visceralFatLevel     Float?        @map("visceral_fat_level")
  waistHipRatio        Float?        @map("waist_hip_ratio")
  inbodyScore          Float?        @map("inbody_score")
  targetWeightKg       Float?        @map("target_weight_kg")
  fatControlKg         Float?        @map("fat_control_kg")
  muscleControlKg      Float?        @map("muscle_control_kg")
  reportUrl            String?       @map("report_url") @db.Text
  source               InbodySource  @default(manual)
  measuredAt           DateTime?     @map("measured_at")
  measurements         Json?
  recordedAt           DateTime      @default(now()) @map("recorded_at")
  createdAt            DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@index([userId, measuredAt], map: "body_metrics_user_measured_idx")
  @@map("body_metrics")
}

model ReadinessLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  date         DateTime @db.Date
  sleepQuality Int?     @map("sleep_quality")
  soreness     Int?
  rpe          Int?
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("readiness_logs")
}

model ProgressSnapshot {
  id                 String             @id @default(uuid())
  userId             String             @map("user_id")
  weekStart          DateTime           @map("week_start") @db.Date
  adherencePct       Float?             @map("adherence_pct")
  workoutAdherence   Float?             @map("workout_adherence")
  nutritionAdherence Float?             @map("nutrition_adherence")
  weightDeltaKg      Float?             @map("weight_delta_kg")
  plateauFlag        Boolean            @default(false) @map("plateau_flag")
  aiSummary          String?            @map("ai_summary") @db.Text
  decision           AdaptationDecision @default(keep)
  createdAt          DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@map("progress_snapshots")
}

model PlanFeedback {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  planId    String?  @map("plan_id")
  weekStart DateTime @map("week_start") @db.Date
  rating    String
  reason    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStart])
  @@map("plan_feedbacks")
}

model PlanChangeLog {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  changeType    String   @map("change_type")
  reason        String?  @db.Text
  beforeSummary Json?    @map("before_summary")
  afterSummary  Json?    @map("after_summary")
  triggeredBy   String   @map("triggered_by")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("plan_change_logs")
}

model ProgressPhoto {
  id          String             @id @default(uuid())
  userId      String             @map("user_id")
  storagePath String             @map("storage_path")
  pose        ProgressPhotoPose?
  analysis    Json?
  caption     String?            @db.Text
  takenAt     DateTime           @default(now()) @map("taken_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, pose])
  @@map("progress_photos")
}

model KnowledgeDocument {
  id          String         @id @default(uuid())
  level       KnowledgeLevel
  source      String
  title       String
  locale      String         @default("en")
  storagePath String?        @map("storage_path")
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  chunks KnowledgeChunk[]

  @@index([level])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id               String   @id @default(uuid())
  documentId       String   @map("document_id")
  content          String   @db.Text
  metadata         Json?
  parentId         String?  @map("parent_id")
  chunkRole        String   @default("standalone") @map("chunk_role")
  embeddingModel   String?  @map("embedding_model")
  embeddingVersion String?  @map("embedding_version")
  createdAt        DateTime @default(now()) @map("created_at")

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent   KnowledgeChunk?  @relation("ChunkParentChild", fields: [parentId], references: [id], onDelete: Cascade)
  children KnowledgeChunk[] @relation("ChunkParentChild")

  @@index([documentId])
  @@index([parentId])
  @@map("knowledge_chunks")
}
