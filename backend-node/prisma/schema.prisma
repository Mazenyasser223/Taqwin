// Taqwin — PostgreSQL schema. Run: npx prisma generate && npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  athlete
  gym
  admin
}

enum OrderStatus {
  pending_payment
  pending
  confirmed
  processing
  packed
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  cod
  card
  fawry
  wallet
}

enum PaymentStatus {
  pending
  processing
  paid
  failed
  refunded
}

enum RecommendationEventType {
  shown
  clicked
  bundle_added
  purchased
  dismissed
  feedback_positive
  feedback_negative
}

enum SubscriptionStatus {
  active
  paused
  cancelled
}

enum ShopFunnelStep {
  visit
  search
  product_view
  add_to_cart
  checkout_start
  paid
}

enum CouponType {
  percent
  fixed
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum InbodySource {
  manual
  inbody_upload
  ai_extracted
}

enum ProgressPhotoPose {
  front
  side
  back
}

// ─── Auth / Identity ─────────────────────────────────────────────────────────

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  passwordHash           String?   @map("password_hash")
  googleId               String?   @unique @map("google_id")
  role                   Role      @default(athlete)
  emailVerifiedAt        DateTime? @map("email_verified_at")
  verificationCode       String?   @map("verification_code")
  verificationCodeExpiry DateTime? @map("verification_code_expiry")
  passwordResetToken     String?   @unique @map("password_reset_token")
  passwordResetExpiry    DateTime? @map("password_reset_expiry")
  pendingEmail           String?   @map("pending_email")
  emailChangeCode        String?   @map("email_change_code")
  emailChangeCodeExpiry  DateTime? @map("email_change_code_expiry")
  twoFactorEnabled       Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret        String?   @map("two_factor_secret")
  phone                  String?   @unique @map("phone")
  phoneVerifiedAt        DateTime? @map("phone_verified_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  lastSeenAt             DateTime? @map("last_seen_at")

  athleteProfile    AthleteProfile?
  gymProfile        GymProfile?
  ownedGyms         Gym[]              @relation("GymOwner")
  gymMemberships    GymMembership[]
  gymCheckIns       GymCheckIn[]
  gymCheckInsRegistered GymCheckIn[] @relation("GymCheckInRegisteredBy")
  gymClassBookings  GymClassBooking[]
  workoutLogs       WorkoutLog[]
  exerciseLogs      ExerciseLog[]
  savedExercises    SavedExercise[]
  hydrationLogs     HydrationLog[]
  createdWorkouts   Workout[]          @relation("WorkoutCreator")
  kitchenFoods      FoodItem[]          @relation("FoodItemOwner")
  savedMeals        UserMeal[]
  savedWorkoutRoutines SavedWorkoutRoutine[]
  foodLogs          FoodLog[]
  orders            Order[]
  recommendationEvents RecommendationEvent[]
  productReviews    ProductReview[]
  reviewVotes       ReviewVote[]
  productWishlists  ProductWishlist[]
  productSubscriptions ProductSubscription[]
  shopFunnelEvents  ShopFunnelEvent[]
  couponRedemptions ShopCouponRedemption[]
  referralCode      ReferralCode?
  referralsSent     ReferralInvite[] @relation("ReferrerInvites")
  referralReceived  ReferralInvite?  @relation("RefereeInvite")
  loyaltyAccount    LoyaltyAccount?
  loyaltyTransactions LoyaltyTransaction[]
  adminAuditLogs    AdminAuditLog[] @relation("AdminAuditActor")
  communityPosts    CommunityPost[]
  communityComments CommunityComment[]
  commentLikes      CommunityCommentLike[]
  postLikes         CommunityPostLike[]
  pollVotes         CommunityPollVote[]
  postReposts       CommunityPostRepost[]
  following         CommunityFollow[]    @relation("UserFollowing")
  followers         CommunityFollow[]    @relation("UserFollowers")
  ownedGroups       CommunityGroup[]     @relation("GroupOwner")
  groupMemberships  CommunityGroupMember[]
  conversationParticipants CommunityConversationParticipant[]
  sentMessages      CommunityMessage[]
  starredMessages   CommunityMessageStar[]
  communityBlocksSent     CommunityBlock[] @relation("CommunityBlocksSent")
  communityBlocksReceived CommunityBlock[] @relation("CommunityBlocksReceived")
  dmConversationsInitiated CommunityConversation[] @relation("DmInitiator")
  communityPrivacySettings CommunityPrivacySettings?
  postTagsReceived        CommunityPostTag[]     @relation("TaggedInPosts")
  savedPosts              CommunitySavedPost[]
  postRingsGiven          CommunityPostRing[]    @relation("RingSubscriber")
  postRingsReceived       CommunityPostRing[]    @relation("RingTarget")
  stories                 CommunityStory[]
  storyViews              CommunityStoryView[]
  storyReactions          CommunityStoryReaction[]
  storyReplies            CommunityStoryReply[]
  storyMentionsReceived   CommunityStoryMention[] @relation("StoryMentionedUser")
  storyReshareAttributions CommunityStory[]       @relation("StoryReshareAttribution")
  notifications           Notification[]
  notificationsSent       Notification[]         @relation("NotificationActor")
  settings          UserSettings?
  supportTickets    SupportTicket[]

  // AI Coach (Block A0)
  aiMemories         AiMemory[]
  aiToolExecutions   AiToolExecution[]
  workoutPlans       WorkoutPlan[]
  dietPlans          DietPlan[]
  dailyAthletePlans  DailyAthletePlan[]
  bodyMetrics        BodyMetric[]
  readinessLogs      ReadinessLog[]
  progressSnapshots  ProgressSnapshot[]
  planFeedbacks      PlanFeedback[]
  planChangeLogs     PlanChangeLog[]
  progressPhotos     ProgressPhoto[]
  athleteDailyScores AthleteDailyScore[]
  gamification       UserGamification?
  leagueMemberships  LeagueMembership[]
  userAchievements   UserAchievement[]
  challengeParticipants ChallengeParticipant[]
  challengeDuelsAsChallenger ChallengeDuel[] @relation("DuelChallenger")
  challengeDuelsAsOpponent   ChallengeDuel[] @relation("DuelOpponent")
  challengeSquadsOwned       ChallengeSquad[] @relation("SquadOwner")
  challengeSquadMemberships  ChallengeSquadMember[]

  @@map("users")
}

enum SupportTicketStatus {
  open
  in_progress
  resolved
}

enum SupportTicketCategory {
  account
  booking
  membership
  payments
  technical
  other
}

model SupportTicket {
  id          String                @id @default(uuid())
  userId      String                @map("user_id")
  category    SupportTicketCategory @default(other)
  subject     String
  description String                @db.Text
  imageUrl    String?               @map("image_url")
  status      SupportTicketStatus   @default(open)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("support_tickets")
}

model UserSettings {
  id                     String   @id @default(uuid())
  userId                 String   @unique @map("user_id")
  language               String   @default("en")
  theme                  String   @default("dark")
  notifyWorkoutReminders Boolean  @default(true) @map("notify_workout_reminders")
  notifyAiSuggestions    Boolean  @default(true) @map("notify_ai_suggestions")
  notifyPromotional      Boolean  @default(true) @map("notify_promotional")
  publicProfile          Boolean  @default(false) @map("public_profile")
  unitSystem             String   @default("metric") @map("unit_system")
  timezone               String   @default("UTC") @map("timezone")
  leagueOptIn            Boolean  @default(false) @map("league_opt_in")
  leaderboardVisibility  String   @default("off") @map("leaderboard_visibility")
  showOnLeaderboard      Boolean  @default(false) @map("show_on_leaderboard")
  challengeNotifications Boolean  @default(true) @map("challenge_notifications")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ─── Gamification (Phase 0 — fitness score + league prep) ───────────────────

model AthleteDailyScore {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  dateKey    String   @map("date_key")
  score      Int
  sleepPts   Float    @map("sleep_pts")
  mealsPts   Float    @map("meals_pts")
  waterPts   Float    @map("water_pts")
  workoutPts Float    @map("workout_pts")
  computedAt DateTime @default(now()) @map("computed_at")
  source     String   @default("cron")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([dateKey, score])
  @@map("athlete_daily_scores")
}

model UserGamification {
  userId       String   @id @map("user_id")
  currentTier  String   @default("bronze") @map("current_tier")
  lifetimeXp   Int      @default(0) @map("lifetime_xp")
  currentXp    Int      @default(0) @map("current_xp")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_gamification")
}

model LeagueSeason {
  id        String   @id @default(uuid())
  weekStart String   @map("week_start")
  weekEnd   String   @map("week_end")
  status    String   @default("open")
  closedAt  DateTime? @map("closed_at")
  createdAt DateTime @default(now()) @map("created_at")

  memberships LeagueMembership[]

  @@unique([weekStart])
  @@map("league_seasons")
}

model LeagueMembership {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  seasonId     String   @map("season_id")
  tier         String   @default("bronze")
  weeklyAvg    Int?     @map("weekly_avg")
  daysCounted  Int      @default(0) @map("days_counted")
  rank         Int?
  promoted     Boolean  @default(false)
  demoted      Boolean  @default(false)
  xpAwarded    Int      @default(0) @map("xp_awarded")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  season LeagueSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@index([seasonId, tier, weeklyAvg])
  @@map("league_memberships")
}

model UserAchievement {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  slug      String
  earnedAt  DateTime @default(now()) @map("earned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@map("user_achievements")
}

model ChallengeTemplate {
  slug         String   @id
  durationDays Int      @map("duration_days")
  metric       String
  target       Int
  xpReward     Int      @map("xp_reward")
  badgeSlug    String   @map("badge_slug")
  icon         String   @default("flag")
  sortOrder    Int      @default(0) @map("sort_order")
  active       Boolean  @default(true)

  participants ChallengeParticipant[]

  @@map("challenge_templates")
}

model ChallengeParticipant {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  templateSlug String    @map("template_slug")
  mode         String    @default("solo")
  duelId       String?   @map("duel_id")
  squadId      String?   @map("squad_id")
  startDateKey String    @map("start_date_key")
  endDateKey   String    @map("end_date_key")
  progress     Int       @default(0)
  target       Int
  status       String    @default("active")
  completedAt  DateTime? @map("completed_at")
  xpAwarded    Int       @default(0) @map("xp_awarded")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template ChallengeTemplate @relation(fields: [templateSlug], references: [slug], onDelete: Cascade)
  duel     ChallengeDuel?    @relation(fields: [duelId], references: [id], onDelete: SetNull)
  squad    ChallengeSquad?   @relation(fields: [squadId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([templateSlug, status])
  @@index([duelId])
  @@index([squadId])
  @@map("challenge_participants")
}

model ChallengeDuel {
  id                        String    @id @default(uuid())
  templateSlug              String    @map("template_slug")
  challengerId              String    @map("challenger_id")
  opponentId                String    @map("opponent_id")
  challengerParticipantId   String?   @map("challenger_participant_id")
  opponentParticipantId     String?   @map("opponent_participant_id")
  status                    String    @default("pending")
  winnerId                  String?   @map("winner_id")
  startDateKey              String?   @map("start_date_key")
  endDateKey                String?   @map("end_date_key")
  target                    Int?
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  challenger   User                   @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent     User                   @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]

  @@index([challengerId, status])
  @@index([opponentId, status])
  @@map("challenge_duels")
}

model ChallengeSquad {
  id           String    @id @default(uuid())
  templateSlug String    @map("template_slug")
  ownerId      String    @map("owner_id")
  name         String?
  status       String    @default("recruiting")
  maxMembers   Int       @default(5) @map("max_members")
  startDateKey String?   @map("start_date_key")
  endDateKey   String?   @map("end_date_key")
  target       Int?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  owner        User                   @relation("SquadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      ChallengeSquadMember[]
  participants ChallengeParticipant[]

  @@index([ownerId, status])
  @@index([templateSlug, status])
  @@map("challenge_squads")
}

model ChallengeSquadMember {
  id        String   @id @default(uuid())
  squadId   String   @map("squad_id")
  userId    String   @map("user_id")
  role      String   @default("member")
  joinedAt  DateTime @default(now()) @map("joined_at")

  squad ChallengeSquad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([squadId, userId])
  @@map("challenge_squad_members")
}

model AthleteProfile {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  displayName    String?   @map("display_name")
  avatarUrl      String?   @map("avatar_url")
  communityAvatarUrl String? @map("community_avatar_url")
  coverUrl       String?   @map("cover_url")
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  gender         String?
  height         Float?
  weight         Float?
  fitnessGoal    String?   @map("fitness_goal")
  fitnessLevel   String?   @map("fitness_level")
  medicalNotes   String?   @map("medical_notes") @db.Text
  onboardingData Json?     @map("onboarding_data")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("athlete_profiles")
}

model GymProfile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  displayName     String?  @map("display_name")
  avatarUrl       String?  @map("avatar_url")
  communityAvatarUrl String? @map("community_avatar_url")
  coverUrl        String?  @map("cover_url")
  bio             String?  @db.Text
  businessName    String?  @map("business_name")
  businessAddress String?  @map("business_address") @db.Text
  businessPhone   String?  @map("business_phone")
  websiteUrl      String?  @map("website_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gym_profiles")
}

// ─── Gyms ────────────────────────────────────────────────────────────────────

model Gym {
  id          String  @id @default(uuid())
  ownerId     String  @map("owner_id")
  name        String
  location    String
  latitude    Float?
  longitude   Float?
  bio         String? @db.Text
  imageUrl    String? @map("image_url")
  galleryUrls Json    @default("[]") @map("gallery_urls")
  videoUrl    String? @map("video_url")
  workingHours Json   @default("[]") @map("working_hours")
  phone       String?
  maxCapacity Int     @default(100) @map("max_capacity")
  amenities   String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner       User            @relation("GymOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships   GymMembership[]
  checkIns      GymCheckIn[]
  postMentions  CommunityPostGymMention[]
  subscriptionPlans GymSubscriptionPlan[]
  equipment     GymEquipment[]
  staff         GymStaff[]
  classes       GymClass[]
  classBookings GymClassBooking[]

  @@map("gyms")
}

enum GymStaffRole {
  trainer
  receptionist
  cleaner
  other
}

enum GymClassBookingStatus {
  booked
  cancelled
  attended
  no_show
}

enum GymStaffPayoutType {
  salary
  bonus
}

enum GymStaffPayoutStatus {
  pending
  paid
  failed
}

enum GymStaffPayoutProvider {
  mock
  paymob
  manual
  cash
}

model GymStaff {
  id           String       @id @default(uuid())
  gymId        String       @map("gym_id")
  fullName     String       @map("full_name")
  email        String?
  phone        String?
  role         GymStaffRole @default(other)
  baseSalary   Float        @default(0) @map("base_salary")
  workingHours Json         @default("[]") @map("working_hours")
  isActive     Boolean      @default(true) @map("is_active")
  hiredAt      DateTime?    @map("hired_at")
  notes        String?      @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  gym     Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  payouts GymStaffPayout[]
  classes GymClass[]

  @@index([gymId, isActive, role])
  @@map("gym_staff")
}

model GymClass {
  id          String   @id @default(uuid())
  gymId       String   @map("gym_id")
  name        String
  nameAr      String?  @map("name_ar")
  description String?  @db.Text
  price       Float
  currency    String   @default("EGP")
  staffId     String   @map("staff_id")
  sessionDate DateTime @map("session_date") @db.Date
  dayOfWeek   Int      @map("day_of_week")
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  gym      Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  staff    GymStaff          @relation(fields: [staffId], references: [id], onDelete: Restrict)
  bookings GymClassBooking[]

  @@index([gymId])
  @@index([staffId])
  @@map("gym_classes")
}

model GymClassBooking {
  id            String                @id @default(uuid())
  gymId         String                @map("gym_id")
  classId       String                @map("class_id")
  userId        String                @map("user_id")
  sessionDate   DateTime              @map("session_date") @db.Date
  paidAmount    Float                 @map("paid_amount")
  paymentMethod String                @map("payment_method")
  status        GymClassBookingStatus @default(booked)
  notes         String?               @db.Text
  createdAt     DateTime              @default(now()) @map("created_at")

  gym   Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  class GymClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId, sessionDate])
  @@index([gymId])
  @@index([classId])
  @@index([userId])
  @@map("gym_class_bookings")
}

model GymStaffPayout {
  id           String                 @id @default(uuid())
  gymId        String                 @map("gym_id")
  staffId      String                 @map("staff_id")
  type         GymStaffPayoutType
  baseAmount   Float                  @default(0) @map("base_amount")
  bonusAmount  Float                  @default(0) @map("bonus_amount")
  totalAmount  Float                  @map("total_amount")
  periodMonth  Int?                   @map("period_month")
  periodYear   Int?                   @map("period_year")
  status       GymStaffPayoutStatus   @default(pending)
  provider     GymStaffPayoutProvider @default(mock)
  externalId   String?                @map("external_id")
  paidAt       DateTime?              @map("paid_at")
  notes        String?                @db.Text
  createdAt    DateTime               @default(now()) @map("created_at")

  staff GymStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([gymId, periodYear, periodMonth])
  @@index([staffId, createdAt])
  @@map("gym_staff_payouts")
}

model GymEquipment {
  id                      String    @id @default(uuid())
  gymId                   String    @map("gym_id")
  name                    String
  nameAr                  String?   @map("name_ar")
  imageUrl                String?   @map("image_url")
  lastMaintenanceAt       DateTime? @map("last_maintenance_at")
  nextMaintenanceAt       DateTime? @map("next_maintenance_at")
  lastCleanedAt           DateTime? @map("last_cleaned_at")
  maintenanceIntervalDays Int       @default(90) @map("maintenance_interval_days")
  needsMaintenance        Boolean   @default(false) @map("needs_maintenance")
  needsCleaning           Boolean   @default(false) @map("needs_cleaning")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, needsMaintenance, needsCleaning])
  @@map("gym_equipment")
}

model GymSubscriptionPlan {
  id           String  @id @default(uuid())
  gymId        String  @map("gym_id")
  name         String
  nameAr       String? @map("name_ar")
  durationDays Int     @map("duration_days")
  price        Float
  currency     String  @default("EGP")
  description  String? @db.Text
  benefits     Json?
  isActive     Boolean @default(true) @map("is_active")
  sortOrder    Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gym         Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberships GymMembership[]

  @@index([gymId, isActive, sortOrder])
  @@map("gym_subscription_plans")
}

model GymMembership {
  id            String    @id @default(uuid())
  gymId         String    @map("gym_id")
  userId        String    @map("user_id")
  planId        String?   @map("plan_id")
  joinedAt      DateTime  @default(now()) @map("joined_at")
  expiresAt     DateTime? @map("expires_at")
  isActive      Boolean   @default(true) @map("is_active")
  paidAmount    Float?    @map("paid_amount")
  paymentMethod String?   @map("payment_method")
  paidAt        DateTime? @map("paid_at")

  gym  Gym                  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan GymSubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@unique([gymId, userId])
  @@map("gym_memberships")
}

model GymCheckIn {
  id               String    @id @default(uuid())
  gymId            String    @map("gym_id")
  userId           String    @map("user_id")
  checkedInAt      DateTime  @default(now()) @map("checked_in_at")
  checkedOutAt     DateTime? @map("checked_out_at")
  registeredById   String?   @map("registered_by_id")

  gym          Gym   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user         User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredBy User? @relation("GymCheckInRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  checkInPost  CommunityPost?

  @@index([gymId, checkedInAt])
  @@index([gymId, userId, checkedOutAt])
  @@map("gym_check_ins")
}

// ─── Workouts ────────────────────────────────────────────────────────────────

model Workout {
  id          String  @id @default(uuid())
  createdById String? @map("created_by_id")
  title       String
  category    String
  difficulty  String
  durationMin Int     @map("duration_min")
  calories    Int
  imageUrl    String? @map("image_url")
  description String? @db.Text
  isPublic    Boolean @default(true) @map("is_public")

  createdAt DateTime @default(now()) @map("created_at")

  createdBy User?        @relation("WorkoutCreator", fields: [createdById], references: [id], onDelete: Cascade)
  logs      WorkoutLog[]

  @@map("workouts")
}

model WorkoutLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  workoutId   String   @map("workout_id")
  loggedAt    DateTime @default(now()) @map("logged_at")
  durationMin Int?     @map("duration_min")
  notes       String?  @db.Text

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@map("workout_logs")
}

/// Individual exercises (e.g. imported from MuscleWiki).
model Exercise {
  id               String   @id @default(uuid())
  muscleWikiId     Int      @unique @map("musclewiki_id")
  slug             String?
  name             String
  nameAr           String?  @map("name_ar")
  category         String
  difficulty       String?
  force            String?
  mechanic         String?
  grips            Json?
  primaryMuscles   Json     @map("primary_muscles")
  secondaryMuscles Json?    @map("secondary_muscles")
  browseMuscleZone String?  @map("browse_muscle_zone") @db.VarChar(32)
  steps            Json
  videos           Json
  thumbnailUrl     String?  @map("thumbnail_url")
  longDescription  String?  @map("long_description") @db.Text
  source           String   @default("musclewiki")
  isPublic         Boolean  @default(true) @map("is_public")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  logs ExerciseLog[]
  workoutPlanExercises WorkoutPlanExercise[]
  savedWorkoutRoutineExercises SavedWorkoutRoutineExercise[]
  savedByUsers SavedExercise[]

  @@index([category])
  @@index([difficulty])
  @@index([name])
  @@index([browseMuscleZone])
  @@map("exercises")
}

/// User-saved (favorite) exercises for quick access in the workout library.
model SavedExercise {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  exerciseId String   @map("exercise_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([exerciseId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_exercises")
}

model ExerciseLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  exerciseId String   @map("exercise_id")
  loggedAt   DateTime @default(now()) @map("logged_at")
  notes      String?  @db.Text
  sets       Int?
  reps       String?  @db.VarChar(32)
  weightKg   Float?   @map("weight_kg")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@map("exercise_logs")
}

model HydrationLog {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  loggedAt DateTime @default(now()) @map("logged_at")
  ml       Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@map("hydration_logs")
}

// ─── Nutrition ───────────────────────────────────────────────────────────────

model FoodItem {
  id       String  @id @default(uuid())
  fdcId    Int?    @unique @map("fdc_id")
  webtebId Int?    @unique @map("webteb_id")
  userId   String? @map("user_id")
  name     String
  category String
  calories Int
  protein  Float
  carbs    Float
  fat      Float
  saturatedFat Float? @map("saturated_fat")
  transFat     Float? @map("trans_fat")
  cholesterol  Float?
  sodium       Float?
  potassium    Float?
  dietaryFiber Float? @map("dietary_fiber")
  sugars       Float?
  vitaminA     Float? @map("vitamin_a")
  vitaminC     Float? @map("vitamin_c")
  calcium      Float?
  iron         Float?
  imageUrl String? @map("image_url")
  isPublic Boolean @default(true) @map("is_public")

  owner User? @relation("FoodItemOwner", fields: [userId], references: [id], onDelete: Cascade)
  logs FoodLog[]
  dietPlanMealItems DietPlanMealItem[]
  userMealItems UserMealItem[]

  @@index([userId, name])
  @@index([isPublic, name])
  @@map("food_items")
}

model UserMeal {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  name          String
  description   String?  @db.Text
  defaultSlotId String?  @map("default_slot_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items UserMealItem[]

  @@index([userId, name])
  @@map("user_meals")
}

model UserMealItem {
  id         String  @id @default(uuid())
  mealId     String  @map("meal_id")
  foodItemId String? @map("food_item_id")
  name       String
  grams      Float
  calories   Int?
  protein    Float?
  carbs      Float?
  fat        Float?
  sortOrder  Int     @default(0) @map("sort_order")

  meal     UserMeal  @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodItem FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)

  @@index([mealId, sortOrder])
  @@index([foodItemId])
  @@map("user_meal_items")
}

/// WebTeb nutrition taxonomy (maps to Taqwin `nutrition.cat.*` ids).
model WebtebCategory {
  id        String       @id
  slug      String       @unique
  nameAr    String       @map("name_ar")
  icon      String       @default("restaurant")
  sortOrder Int          @default(0) @map("sort_order")
  foods     WebtebFood[]

  @@map("webteb_categories")
}

/// Imported food from webteb.com/nutritionfacts (per 100g unless noted).
model WebtebFood {
  id           String         @id @default(uuid())
  webtebId     Int            @unique @map("webteb_id")
  categoryId   String         @map("category_id")
  categorySlug String         @map("category_slug")
  slug         String
  nameAr       String         @map("name_ar")
  nameEn       String?        @map("name_en")
  url          String
  calories     Int            @default(0)
  protein      Float          @default(0)
  carbs        Float          @default(0)
  fat          Float          @default(0)
  servingUnits Json           @default("[]") @map("serving_units")
  sections     Json           @default("{}")
  scrapedAt    DateTime       @default(now()) @map("scraped_at")
  category     WebtebCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([nameAr])
  @@index([nameEn])
  @@map("webteb_foods")
}

model FoodLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  foodItemId String   @map("food_item_id")
  mealSlotId String?  @map("meal_slot_id") @db.VarChar(64)
  loggedAt   DateTime @default(now()) @map("logged_at")
  grams      Float
  snapshotName     String? @map("snapshot_name")
  snapshotCalories Float?  @map("snapshot_calories")
  snapshotProtein  Float?  @map("snapshot_protein")
  snapshotCarbs    Float?  @map("snapshot_carbs")
  snapshotFat        Float?  @map("snapshot_fat")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@index([userId, mealSlotId, loggedAt])
  @@map("food_logs")
}

// ─── Marketplace (shop catalog) ─────────────────────────────────────────────

model ShopCategory {
  id        String         @id @default(uuid())
  slug      String         @unique
  nameEn    String         @map("name_en")
  nameAr    String?        @map("name_ar")
  icon      String?
  parentId  String?        @map("parent_id")
  sortOrder Int            @default(0) @map("sort_order")
  parent    ShopCategory?  @relation("ShopCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ShopCategory[] @relation("ShopCategoryTree")
  products  Product[]

  @@index([parentId])
  @@map("shop_categories")
}

model Product {
  id              String   @id @default(uuid())
  slug            String?  @unique
  name            String
  nameAr          String?  @map("name_ar")
  brand           String
  categoryId      String?  @map("category_id")
  price           Float
  compareAtPrice  Float?   @map("compare_at_price")
  currency        String   @default("EGP")
  discountPercent Int?     @map("discount_percent")
  priceMin        Float?   @map("price_min")
  priceMax        Float?   @map("price_max")
  hasVariants     Boolean  @default(false) @map("has_variants")
  imageUrl        String?  @map("image_url")
  description     String?  @db.Text
  descriptionAr   String?  @map("description_ar") @db.Text
  stock           Int      @default(0)
  costPrice       Float?   @map("cost_price")
  avgRating       Float?   @default(0) @map("avg_rating")
  salesCount      Int      @default(0) @map("sales_count")
  reviewCount     Int      @default(0) @map("review_count")
  wishlistCount   Int      @default(0) @map("wishlist_count")
  isOnSale        Boolean  @default(false) @map("is_on_sale")
  isFeatured      Boolean  @default(false) @map("is_featured")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category   ShopCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  recommendationEvents RecommendationEvent[]
  reviews ProductReview[]
  wishlists ProductWishlist[]
  subscriptions ProductSubscription[]

  @@index([categoryId])
  @@index([brand])
  @@index([isOnSale])
  @@index([isActive])
  @@map("products")
}

model Order {
  id                  String         @id @default(uuid())
  userId              String         @map("user_id")
  status              OrderStatus    @default(pending_payment)
  paymentStatus       PaymentStatus  @default(pending) @map("payment_status")
  paymentProvider     String?        @map("payment_provider")
  paymentReference    String?        @map("payment_reference")
  paymentMethod       PaymentMethod? @map("payment_method")
  paidAt              DateTime?      @map("paid_at")
  subtotal            Float
  shippingFee         Float          @default(0) @map("shipping_fee")
  total               Float
  currency            String         @default("EGP")
  shippingGovernorate String?        @map("shipping_governorate")
  shippingCity        String?        @map("shipping_city")
  shippingAddress     String?        @map("shipping_address") @db.Text
  shippingPhone       String?        @map("shipping_phone")
  trackingNumber      String?        @map("tracking_number")
  carrier             String?
  shippedAt           DateTime?      @map("shipped_at")
  deliveredAt         DateTime?      @map("delivered_at")
  commerceSource      String?        @map("commerce_source")
  commerceSessionId   String?        @map("commerce_session_id")
  commerceAbVariant   String?        @map("commerce_ab_variant")
  commerceExperimentId String?       @map("commerce_experiment_id")
  discountAmount      Float          @default(0) @map("discount_amount")
  couponCode          String?        @map("coupon_code")
  loyaltyPointsUsed   Int            @default(0) @map("loyalty_points_used")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]
  payments Payment[]
  recommendationEvents RecommendationEvent[]
  productReviews ProductReview[]

  @@index([userId, createdAt])
  @@index([paymentStatus])
  @@index([paymentReference])
  @@index([commerceSource])
  @@map("orders")
}

model Payment {
  id         String        @id @default(uuid())
  orderId    String        @map("order_id")
  provider   String
  amount     Float
  currency   String        @default("EGP")
  status     PaymentStatus @default(pending)
  externalId String?       @map("external_id")
  metadata   Json?
  paidAt     DateTime?     @map("paid_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([externalId])
  @@map("payments")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  productId String @map("product_id")
  quantity  Int    @default(1)
  unitPrice Float  @map("unit_price")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model RecommendationEvent {
  id          String                  @id @default(uuid())
  userId      String?                 @map("user_id")
  eventType   RecommendationEventType @map("event_type")
  source      String
  bundleId    String?                 @map("bundle_id")
  productId   String?                 @map("product_id")
  productIds  String[]                @default([]) @map("product_ids")
  sessionId   String?                 @map("session_id")
  orderId     String?                 @map("order_id")
  metadata    Json?
  createdAt   DateTime                @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@index([sessionId])
  @@index([productId])
  @@map("recommendation_events")
}

model CommerceExperiment {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  status           String   @default("active")
  winnerVariantKey String?  @map("winner_variant_key")
  minSamples       Int      @default(50) @map("min_samples")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  variants CommerceExperimentVariant[]

  @@map("commerce_experiments")
}

model CommerceExperimentVariant {
  id           String   @id @default(uuid())
  experimentId String   @map("experiment_id")
  key          String
  name         String
  slotConfig   Json     @default("{}") @map("slot_config")
  weight       Int      @default(50)
  isWinner     Boolean  @default(false) @map("is_winner")
  createdAt    DateTime @default(now()) @map("created_at")

  experiment CommerceExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, key])
  @@map("commerce_experiment_variants")
}

model ProductReview {
  id                 String   @id @default(uuid())
  productId          String   @map("product_id")
  userId             String   @map("user_id")
  orderId            String?  @map("order_id")
  rating             Int
  title              String?
  body               String   @db.Text
  isVerifiedPurchase Boolean  @default(false) @map("is_verified_purchase")
  helpfulCount       Int      @default(0) @map("helpful_count")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  votes   ReviewVote[]

  @@unique([productId, userId])
  @@index([productId])
  @@map("product_reviews")
}

model ReviewVote {
  id        String   @id @default(uuid())
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  helpful   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_votes")
}

model ProductWishlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("product_wishlists")
}

model ProductSubscription {
  id             String             @id @default(uuid())
  userId         String             @map("user_id")
  productId      String             @map("product_id")
  quantity       Int                @default(1)
  intervalDays   Int                @default(30) @map("interval_days")
  status         SubscriptionStatus @default(active)
  nextDeliveryAt DateTime           @map("next_delivery_at")
  lastOrderId    String?            @map("last_order_id")
  pausedAt       DateTime?          @map("paused_at")
  cancelledAt    DateTime?          @map("cancelled_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextDeliveryAt])
  @@index([status])
  @@map("product_subscriptions")
}

model ShopFunnelEvent {
  id        String         @id @default(uuid())
  userId    String?        @map("user_id")
  sessionId String         @map("session_id")
  step      ShopFunnelStep
  productId String?        @map("product_id")
  query     String?
  metadata  Json?
  createdAt DateTime       @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([step])
  @@index([sessionId])
  @@index([createdAt])
  @@index([userId])
  @@map("shop_funnel_events")
}

model ShopCoupon {
  id            String     @id @default(uuid())
  code          String     @unique
  type          CouponType
  value         Float
  minOrderTotal Float      @default(0) @map("min_order_total")
  maxUses       Int?       @map("max_uses")
  usedCount     Int        @default(0) @map("used_count")
  perUserLimit  Int        @default(1) @map("per_user_limit")
  startsAt      DateTime?  @map("starts_at")
  expiresAt     DateTime?  @map("expires_at")
  isActive      Boolean    @default(true) @map("is_active")
  descriptionEn String?    @map("description_en")
  descriptionAr String?    @map("description_ar")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  redemptions ShopCouponRedemption[]

  @@map("shop_coupons")
}

model ShopCouponRedemption {
  id        String   @id @default(uuid())
  couponId  String   @map("coupon_id")
  userId    String   @map("user_id")
  orderId   String?  @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  coupon ShopCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@map("shop_coupon_redemptions")
}

model ReferralCode {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

model ReferralInvite {
  id           String   @id @default(uuid())
  referrerId   String   @map("referrer_id")
  refereeId    String?  @unique @map("referee_id")
  refereeEmail String?  @map("referee_email")
  status       String   @default("pending")
  pointsAwarded Int     @default(0) @map("points_awarded")
  createdAt    DateTime @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")

  referrer User  @relation("ReferrerInvites", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User? @relation("RefereeInvite", fields: [refereeId], references: [id], onDelete: SetNull)

  @@index([referrerId])
  @@map("referral_invites")
}

model LoyaltyAccount {
  userId         String   @id @map("user_id")
  points         Int      @default(0)
  lifetimePoints Int      @default(0) @map("lifetime_points")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  points    Int
  type      String
  orderId   String?  @map("order_id")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("loyalty_transactions")
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  admin User @relation("AdminAuditActor", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([entity])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// ─── Community ───────────────────────────────────────────────────────────────

model CommunityPost {
  id             String   @id @default(uuid())
  authorId       String   @map("author_id")
  groupId        String?  @map("group_id")
  content        String   @db.Text
  imageUrl       String?  @map("image_url")
  videoUrl       String?  @map("video_url")
  mediaType      String?  @map("media_type")
  locationName   String?  @map("location_name")
  locationLat    Float?   @map("location_lat")
  locationLng    Float?   @map("location_lng")
  commentsLocked Boolean  @default(false) @map("comments_locked")
  repostsLocked  Boolean  @default(false) @map("reposts_locked")
  visibility     String   @default("everyone")
  likesCount     Int      @default(0) @map("likes_count")
  repostsCount   Int      @default(0) @map("reposts_count")
  profilePinnedAt DateTime? @map("profile_pinned_at")
  groupPinnedAt   DateTime? @map("group_pinned_at")
  checkInId       String?   @unique @map("check_in_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  author   User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  checkIn  GymCheckIn?           @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  group    CommunityGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
