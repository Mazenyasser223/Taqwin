// Taqwin — PostgreSQL schema. Run: npx prisma generate && npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  athlete
  trainer
  gym
}

enum OrderStatus {
  pending_payment
  pending
  confirmed
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  cod
  card
  fawry
  wallet
}

enum PaymentStatus {
  pending
  processing
  paid
  failed
  refunded
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

// ─── Auth / Identity ─────────────────────────────────────────────────────────

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  passwordHash           String?   @map("password_hash")
  googleId               String?   @unique @map("google_id")
  role                   Role      @default(athlete)
  emailVerifiedAt        DateTime? @map("email_verified_at")
  verificationCode       String?   @map("verification_code")
  verificationCodeExpiry DateTime? @map("verification_code_expiry")
  passwordResetToken     String?   @unique @map("password_reset_token")
  passwordResetExpiry    DateTime? @map("password_reset_expiry")
  pendingEmail           String?   @map("pending_email")
  emailChangeCode        String?   @map("email_change_code")
  emailChangeCodeExpiry  DateTime? @map("email_change_code_expiry")
  twoFactorEnabled       Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret        String?   @map("two_factor_secret")
  phone                  String?   @unique @map("phone")
  phoneVerifiedAt        DateTime? @map("phone_verified_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  lastSeenAt             DateTime? @map("last_seen_at")

  profile           Profile?
  ownedGyms         Gym[]              @relation("GymOwner")
  gymMemberships    GymMembership[]
  gymCheckIns       GymCheckIn[]
  gymCheckInsRegistered GymCheckIn[] @relation("GymCheckInRegisteredBy")
  gymClassBookings  GymClassBooking[]
  workoutLogs       WorkoutLog[]
  exerciseLogs      ExerciseLog[]
  createdWorkouts   Workout[]          @relation("WorkoutCreator")
  foodLogs          FoodLog[]
  orders            Order[]
  athleteBookings   TrainerBooking[]   @relation("AthleteBookings")
  trainerBookings   TrainerBooking[]   @relation("TrainerBookings")
  communityPosts    CommunityPost[]
  communityComments CommunityComment[]
  commentLikes      CommunityCommentLike[]
  postLikes         CommunityPostLike[]
  postReposts       CommunityPostRepost[]
  following         CommunityFollow[]    @relation("UserFollowing")
  followers         CommunityFollow[]    @relation("UserFollowers")
  ownedGroups       CommunityGroup[]     @relation("GroupOwner")
  groupMemberships  CommunityGroupMember[]
  conversationParticipants CommunityConversationParticipant[]
  sentMessages      CommunityMessage[]
  communityBlocksSent     CommunityBlock[] @relation("CommunityBlocksSent")
  communityBlocksReceived CommunityBlock[] @relation("CommunityBlocksReceived")
  dmConversationsInitiated CommunityConversation[] @relation("DmInitiator")
  communityPrivacySettings CommunityPrivacySettings?
  postTagsReceived        CommunityPostTag[]     @relation("TaggedInPosts")
  savedPosts              CommunitySavedPost[]
  postRingsGiven          CommunityPostRing[]    @relation("RingSubscriber")
  postRingsReceived       CommunityPostRing[]    @relation("RingTarget")
  stories                 CommunityStory[]
  storyViews              CommunityStoryView[]
  storyReactions          CommunityStoryReaction[]
  storyReplies            CommunityStoryReply[]
  notifications           Notification[]
  notificationsSent       Notification[]         @relation("NotificationActor")
  settings          UserSettings?
  supportTickets    SupportTicket[]

  @@map("users")
}

enum SupportTicketStatus {
  open
  in_progress
  resolved
}

enum SupportTicketCategory {
  account
  booking
  membership
  payments
  technical
  other
}

model SupportTicket {
  id          String                @id @default(uuid())
  userId      String                @map("user_id")
  category    SupportTicketCategory @default(other)
  subject     String
  description String                @db.Text
  imageUrl    String?               @map("image_url")
  status      SupportTicketStatus   @default(open)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("support_tickets")
}

model UserSettings {
  id                     String   @id @default(uuid())
  userId                 String   @unique @map("user_id")
  language               String   @default("en")
  theme                  String   @default("dark")
  notifyWorkoutReminders Boolean  @default(true) @map("notify_workout_reminders")
  notifyAiSuggestions    Boolean  @default(true) @map("notify_ai_suggestions")
  notifyPromotional      Boolean  @default(true) @map("notify_promotional")
  shareWithTrainers      Boolean  @default(true) @map("share_with_trainers")
  publicProfile          Boolean  @default(false) @map("public_profile")
  unitSystem             String   @default("metric") @map("unit_system")
  timezone               String   @default("UTC") @map("timezone")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Profile {
  id           String    @id @default(uuid())
  userId       String    @unique @map("user_id")
  displayName  String?   @map("display_name")
  avatarUrl    String?   @map("avatar_url")
  coverUrl     String?   @map("cover_url")
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  gender       String?
  height       Float?
  weight       Float?
  fitnessGoal  String?   @map("fitness_goal")
  fitnessLevel String?   @map("fitness_level")
  medicalNotes String?   @map("medical_notes") @db.Text
  onboardingData Json?   @map("onboarding_data")

  // Trainer fields
  bio             String? @db.Text
  specialties     String? @db.Text
  yearsExperience Int?    @map("years_experience")

  // Gym / business fields
  businessName    String? @map("business_name")
  businessAddress String? @map("business_address") @db.Text
  businessPhone   String? @map("business_phone")
  websiteUrl      String? @map("website_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ─── Gyms ────────────────────────────────────────────────────────────────────

model Gym {
  id          String  @id @default(uuid())
  ownerId     String  @map("owner_id")
  name        String
  location    String
  latitude    Float?
  longitude   Float?
  bio         String? @db.Text
  imageUrl    String? @map("image_url")
  galleryUrls Json    @default("[]") @map("gallery_urls")
  videoUrl    String? @map("video_url")
  workingHours Json   @default("[]") @map("working_hours")
  phone       String?
  maxCapacity Int     @default(100) @map("max_capacity")
  amenities   String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner       User            @relation("GymOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships   GymMembership[]
  checkIns      GymCheckIn[]
  postMentions  CommunityPostGymMention[]
  subscriptionPlans GymSubscriptionPlan[]
  equipment     GymEquipment[]
  staff         GymStaff[]
  classes       GymClass[]
  classBookings GymClassBooking[]

  @@map("gyms")
}

enum GymStaffRole {
  trainer
  receptionist
  cleaner
  other
}

enum GymClassBookingStatus {
  booked
  cancelled
  attended
  no_show
}

enum GymStaffPayoutType {
  salary
  bonus
}

enum GymStaffPayoutStatus {
  pending
  paid
  failed
}

enum GymStaffPayoutProvider {
  mock
  paymob
  manual
  cash
}

model GymStaff {
  id           String       @id @default(uuid())
  gymId        String       @map("gym_id")
  fullName     String       @map("full_name")
  email        String?
  phone        String?
  role         GymStaffRole @default(other)
  baseSalary   Float        @default(0) @map("base_salary")
  workingHours Json         @default("[]") @map("working_hours")
  isActive     Boolean      @default(true) @map("is_active")
  hiredAt      DateTime?    @map("hired_at")
  notes        String?      @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  gym     Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  payouts GymStaffPayout[]
  classes GymClass[]

  @@index([gymId, isActive, role])
  @@map("gym_staff")
}

model GymClass {
  id          String   @id @default(uuid())
  gymId       String   @map("gym_id")
  name        String
  nameAr      String?  @map("name_ar")
  description String?  @db.Text
  price       Float
  currency    String   @default("EGP")
  staffId     String   @map("staff_id")
  sessionDate DateTime @map("session_date") @db.Date
  dayOfWeek   Int      @map("day_of_week")
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  gym      Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  staff    GymStaff          @relation(fields: [staffId], references: [id], onDelete: Restrict)
  bookings GymClassBooking[]

  @@index([gymId])
  @@index([staffId])
  @@map("gym_classes")
}

model GymClassBooking {
  id            String                @id @default(uuid())
  gymId         String                @map("gym_id")
  classId       String                @map("class_id")
  userId        String                @map("user_id")
  sessionDate   DateTime              @map("session_date") @db.Date
  paidAmount    Float                 @map("paid_amount")
  paymentMethod String                @map("payment_method")
  status        GymClassBookingStatus @default(booked)
  notes         String?               @db.Text
  createdAt     DateTime              @default(now()) @map("created_at")

  gym   Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  class GymClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId, sessionDate])
  @@index([gymId])
  @@index([classId])
  @@index([userId])
  @@map("gym_class_bookings")
}

model GymStaffPayout {
  id           String                 @id @default(uuid())
  gymId        String                 @map("gym_id")
  staffId      String                 @map("staff_id")
  type         GymStaffPayoutType
  baseAmount   Float                  @default(0) @map("base_amount")
  bonusAmount  Float                  @default(0) @map("bonus_amount")
  totalAmount  Float                  @map("total_amount")
  periodMonth  Int?                   @map("period_month")
  periodYear   Int?                   @map("period_year")
  status       GymStaffPayoutStatus   @default(pending)
  provider     GymStaffPayoutProvider @default(mock)
  externalId   String?                @map("external_id")
  paidAt       DateTime?              @map("paid_at")
  notes        String?                @db.Text
  createdAt    DateTime               @default(now()) @map("created_at")

  staff GymStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([gymId, periodYear, periodMonth])
  @@index([staffId, createdAt])
  @@map("gym_staff_payouts")
}

model GymEquipment {
  id                      String    @id @default(uuid())
  gymId                   String    @map("gym_id")
  name                    String
  nameAr                  String?   @map("name_ar")
  imageUrl                String?   @map("image_url")
  lastMaintenanceAt       DateTime? @map("last_maintenance_at")
  nextMaintenanceAt       DateTime? @map("next_maintenance_at")
  lastCleanedAt           DateTime? @map("last_cleaned_at")
  maintenanceIntervalDays Int       @default(90) @map("maintenance_interval_days")
  needsMaintenance        Boolean   @default(false) @map("needs_maintenance")
  needsCleaning           Boolean   @default(false) @map("needs_cleaning")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, needsMaintenance, needsCleaning])
  @@map("gym_equipment")
}

model GymSubscriptionPlan {
  id           String  @id @default(uuid())
  gymId        String  @map("gym_id")
  name         String
  nameAr       String? @map("name_ar")
  durationDays Int     @map("duration_days")
  price        Float
  currency     String  @default("EGP")
  description  String? @db.Text
  benefits     Json?
  isActive     Boolean @default(true) @map("is_active")
  sortOrder    Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gym         Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberships GymMembership[]

  @@index([gymId, isActive, sortOrder])
  @@map("gym_subscription_plans")
}

model GymMembership {
  id            String    @id @default(uuid())
  gymId         String    @map("gym_id")
  userId        String    @map("user_id")
  planId        String?   @map("plan_id")
  joinedAt      DateTime  @default(now()) @map("joined_at")
  expiresAt     DateTime? @map("expires_at")
  isActive      Boolean   @default(true) @map("is_active")
  paidAmount    Float?    @map("paid_amount")
  paymentMethod String?   @map("payment_method")
  paidAt        DateTime? @map("paid_at")

  gym  Gym                  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan GymSubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@unique([gymId, userId])
  @@map("gym_memberships")
}

model GymCheckIn {
  id               String    @id @default(uuid())
  gymId            String    @map("gym_id")
  userId           String    @map("user_id")
  checkedInAt      DateTime  @default(now()) @map("checked_in_at")
  checkedOutAt     DateTime? @map("checked_out_at")
  registeredById   String?   @map("registered_by_id")

  gym          Gym   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user         User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredBy User? @relation("GymCheckInRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)

  @@index([gymId, checkedInAt])
  @@index([gymId, userId, checkedOutAt])
  @@map("gym_check_ins")
}

// ─── Workouts ────────────────────────────────────────────────────────────────

model Workout {
  id          String  @id @default(uuid())
  createdById String? @map("created_by_id")
  title       String
  category    String
  difficulty  String
  durationMin Int     @map("duration_min")
  calories    Int
  imageUrl    String? @map("image_url")
  description String? @db.Text
  isPublic    Boolean @default(true) @map("is_public")

  createdAt DateTime @default(now()) @map("created_at")

  createdBy User?        @relation("WorkoutCreator", fields: [createdById], references: [id], onDelete: Cascade)
  logs      WorkoutLog[]

  @@map("workouts")
}

model WorkoutLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  workoutId   String   @map("workout_id")
  loggedAt    DateTime @default(now()) @map("logged_at")
  durationMin Int?     @map("duration_min")
  notes       String?  @db.Text

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@map("workout_logs")
}

/// Individual exercises (e.g. imported from MuscleWiki).
model Exercise {
  id               String   @id @default(uuid())
  muscleWikiId     Int      @unique @map("musclewiki_id")
  slug             String?
  name             String
  nameAr           String?  @map("name_ar")
  category         String
  difficulty       String?
  force            String?
  mechanic         String?
  grips            Json?
  primaryMuscles   Json     @map("primary_muscles")
  secondaryMuscles Json?    @map("secondary_muscles")
  steps            Json
  videos           Json
  thumbnailUrl     String?  @map("thumbnail_url")
  longDescription  String?  @map("long_description") @db.Text
  source           String   @default("musclewiki")
  isPublic         Boolean  @default(true) @map("is_public")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  logs ExerciseLog[]

  @@index([category])
  @@index([difficulty])
  @@index([name])
  @@map("exercises")
}

model ExerciseLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  exerciseId String   @map("exercise_id")
  loggedAt   DateTime @default(now()) @map("logged_at")
  notes      String?  @db.Text

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@map("exercise_logs")
}

// ─── Nutrition ───────────────────────────────────────────────────────────────

model FoodItem {
  id       String  @id @default(uuid())
  fdcId    Int?    @unique @map("fdc_id")
  webtebId Int?    @unique @map("webteb_id")
  name     String
  category String
  calories Int
  protein  Float
  carbs    Float
  fat      Float
  imageUrl String? @map("image_url")
  isPublic Boolean @default(true) @map("is_public")

  logs FoodLog[]

  @@map("food_items")
}

/// WebTeb nutrition taxonomy (maps to Taqwin `nutrition.cat.*` ids).
model WebtebCategory {
  id        String       @id
  slug      String       @unique
  nameAr    String       @map("name_ar")
  icon      String       @default("restaurant")
  sortOrder Int          @default(0) @map("sort_order")
  foods     WebtebFood[]

  @@map("webteb_categories")
}

/// Imported food from webteb.com/nutritionfacts (per 100g unless noted).
model WebtebFood {
  id           String         @id @default(uuid())
  webtebId     Int            @unique @map("webteb_id")
  categoryId   String         @map("category_id")
  categorySlug String         @map("category_slug")
  slug         String
  nameAr       String         @map("name_ar")
  nameEn       String?        @map("name_en")
  url          String
  calories     Int            @default(0)
  protein      Float          @default(0)
  carbs        Float          @default(0)
  fat          Float          @default(0)
  servingUnits Json           @default("[]") @map("serving_units")
  sections     Json           @default("{}")
  scrapedAt    DateTime       @default(now()) @map("scraped_at")
  category     WebtebCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([nameAr])
  @@index([nameEn])
  @@map("webteb_foods")
}

model FoodLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  foodItemId String   @map("food_item_id")
  loggedAt   DateTime @default(now()) @map("logged_at")
  grams      Float

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@map("food_logs")
}

// ─── Marketplace (shop catalog) ─────────────────────────────────────────────

model ShopCategory {
  id        String         @id @default(uuid())
  slug      String         @unique
  nameEn    String         @map("name_en")
  nameAr    String?        @map("name_ar")
  icon      String?
  parentId  String?        @map("parent_id")
  sortOrder Int            @default(0) @map("sort_order")
  parent    ShopCategory?  @relation("ShopCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ShopCategory[] @relation("ShopCategoryTree")
  products  Product[]

  @@index([parentId])
  @@map("shop_categories")
}

model Product {
  id              String   @id @default(uuid())
  slug            String?  @unique
  name            String
  nameAr          String?  @map("name_ar")
  brand           String
  categoryId      String?  @map("category_id")
  price           Float
  compareAtPrice  Float?   @map("compare_at_price")
  currency        String   @default("EGP")
  discountPercent Int?     @map("discount_percent")
  priceMin        Float?   @map("price_min")
  priceMax        Float?   @map("price_max")
  hasVariants     Boolean  @default(false) @map("has_variants")
  imageUrl        String?  @map("image_url")
  description     String?  @db.Text
  descriptionAr   String?  @map("description_ar") @db.Text
  stock           Int      @default(0)
  isOnSale        Boolean  @default(false) @map("is_on_sale")
  isFeatured      Boolean  @default(false) @map("is_featured")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category   ShopCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([brand])
  @@index([isOnSale])
  @@index([isActive])
  @@map("products")
}

model Order {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  status        OrderStatus    @default(pending_payment)
  subtotal      Float
  shippingFee   Float          @default(0) @map("shipping_fee")
  total         Float
  currency      String         @default("EGP")
  paymentMethod PaymentMethod? @map("payment_method")

  shippingGovernorate String? @map("shipping_governorate")
  shippingCity        String? @map("shipping_city")
  shippingAddress     String? @map("shipping_address") @db.Text
  shippingPhone       String? @map("shipping_phone")
  trackingNumber      String? @map("tracking_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  payments Payment[]

  @@index([userId, createdAt])
  @@map("orders")
}

model Payment {
  id         String        @id @default(uuid())
  orderId    String        @map("order_id")
  provider   String
  amount     Float
  currency   String        @default("EGP")
  status     PaymentStatus @default(pending)
  externalId String?       @map("external_id")
  metadata   Json?
  paidAt     DateTime?     @map("paid_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([externalId])
  @@map("payments")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  productId String @map("product_id")
  quantity  Int    @default(1)
  unitPrice Float  @map("unit_price")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ─── Trainer Bookings ────────────────────────────────────────────────────────

model TrainerBooking {
  id          String        @id @default(uuid())
  athleteId   String        @map("athlete_id")
  trainerId   String        @map("trainer_id")
  scheduledAt DateTime      @map("scheduled_at")
  status      BookingStatus @default(pending)
  notes       String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  athlete User @relation("AthleteBookings", fields: [athleteId], references: [id], onDelete: Cascade)
  trainer User @relation("TrainerBookings", fields: [trainerId], references: [id], onDelete: Cascade)

  @@map("trainer_bookings")
}

// ─── Community ───────────────────────────────────────────────────────────────

model CommunityPost {
  id             String   @id @default(uuid())
  authorId       String   @map("author_id")
  groupId        String?  @map("group_id")
  content        String   @db.Text
  imageUrl       String?  @map("image_url")
  videoUrl       String?  @map("video_url")
  mediaType      String?  @map("media_type")
  locationName   String?  @map("location_name")
  locationLat    Float?   @map("location_lat")
  locationLng    Float?   @map("location_lng")
  commentsLocked Boolean  @default(false) @map("comments_locked")
  repostsLocked  Boolean  @default(false) @map("reposts_locked")
  visibility     String   @default("everyone")
  likesCount     Int      @default(0) @map("likes_count")
  repostsCount   Int      @default(0) @map("reposts_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  author   User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group    CommunityGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  comments CommunityComment[]
  likes    CommunityPostLike[]
  reposts  CommunityPostRepost[]
  tags        CommunityPostTag[]
  gymMentions CommunityPostGymMention[]
  saves       CommunitySavedPost[]
  media       CommunityPostMedia[]

  @@index([createdAt])
  @@index([groupId])
  @@map("community_posts")
}

model CommunityPostMedia {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  url       String
  mediaType String   @map("media_type")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
  @@map("community_post_media")
}

model CommunityPostRepost {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("community_post_reposts")
}

model CommunityFollow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  status      String   @default("accepted") // accepted | pending
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("community_follows")
}

model CommunityGroup {
  id               String   @id @default(uuid())
  ownerId          String   @map("owner_id")
  name             String
  description      String?  @db.Text
  imageUrl         String?  @map("image_url")
  postPermission     String   @default("all_members") @map("post_permission")
  invitePermission   String   @default("admins_only") @map("invite_permission")
  joinPolicy         String   @default("open") @map("join_policy")
  postsVisibility    String   @default("members_only") @map("posts_visibility")
  membersVisibility  String   @default("all_members") @map("members_visibility")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  owner   User                   @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members CommunityGroupMember[]
  posts   CommunityPost[]

  @@map("community_groups")
}

model CommunityGroupMember {
  id       String   @id @default(uuid())
  groupId  String   @map("group_id")
  userId   String   @map("user_id")
  role       String   @default("member")
  status     String   @default("accepted")
  invitedBy  String?  @map("invited_by")
  joinedAt   DateTime @default(now()) @map("joined_at")

  group CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("community_group_members")
}

model CommunityBlock {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("CommunityBlocksSent", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("CommunityBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("community_blocks")
}

model CommunityConversation {
  id            String   @id @default(uuid())
  status        String   @default("active")
  initiatedById String?  @map("initiated_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  initiatedBy  User?                              @relation("DmInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  participants CommunityConversationParticipant[]
  messages     CommunityMessage[]

  @@map("community_conversations")
}

model CommunityConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  userId         String    @map("user_id")
  lastReadAt     DateTime? @map("last_read_at")

  conversation CommunityConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("community_conversation_participants")
}

model CommunityMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  messageType    String   @default("text") @map("message_type")
  content        String   @db.Text
  mediaUrl       String?  @map("media_url")
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation CommunityConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("community_messages")
}

model CommunityPrivacySettings {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  repostsAudience    String   @default("followers") @map("reposts_audience")
  savedPostsAudience String   @default("only_me") @map("saved_posts_audience")
  storyAudience      String   @default("followers") @map("story_audience")
  mentionsAudience   String   @default("everyone") @map("mentions_audience")
  sharesAudience     String   @default("everyone") @map("shares_audience")
  presenceAudience   String   @default("everyone") @map("presence_audience")
  storyHideFromIds   Json     @default("[]") @map("story_hide_from_ids")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("community_privacy_settings")
}

model CommunityPostTag {
  id           String   @id @default(uuid())
  postId       String   @map("post_id")
  taggedUserId String   @map("tagged_user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  taggedUser User          @relation("TaggedInPosts", fields: [taggedUserId], references: [id], onDelete: Cascade)

  @@unique([postId, taggedUserId])
  @@map("community_post_tags")
}

model CommunitySavedPost {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("community_saved_posts")
}

model CommunityPostRing {
  id           String   @id @default(uuid())
  subscriberId String   @map("subscriber_id")
  targetUserId String   @map("target_user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  subscriber User @relation("RingSubscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  target     User @relation("RingTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, targetUserId])
  @@map("community_post_rings")
}

model CommunityStory {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  mediaUrl  String   @map("media_url")
  mediaType String   @default("image") @map("media_type")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  author    User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views     CommunityStoryView[]
  reactions CommunityStoryReaction[]
  replies   CommunityStoryReply[]

  @@index([authorId, expiresAt])
  @@map("community_stories")
}

model CommunityPostGymMention {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  gymId     String   @map("gym_id")
  createdAt DateTime @default(now()) @map("created_at")

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  gym  Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([postId, gymId])
  @@map("community_post_gym_mentions")
}

model CommunityStoryReaction {
  id        String   @id @default(uuid())
  storyId   String   @map("story_id")
  userId    String   @map("user_id")
  emoji     String   @default("love")
  createdAt DateTime @default(now()) @map("created_at")

  story CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@map("community_story_reactions")
}

model CommunityStoryReply {
  id        String   @id @default(uuid())
  storyId   String   @map("story_id")
  userId    String   @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  story CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
  @@map("community_story_replies")
}

model CommunityStoryView {
  id       String   @id @default(uuid())
  storyId  String   @map("story_id")
  viewerId String   @map("viewer_id")
  viewedAt DateTime @default(now()) @map("viewed_at")

  story  CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User           @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@map("community_story_views")
}

model CommunityComment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  parentId  String?  @map("parent_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post     CommunityPost        @relation(fields: [postId], references: [id], onDelete: Cascade)
  author   User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   CommunityComment?    @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  CommunityComment[]   @relation("CommentReplies")
  likes    CommunityCommentLike[]

  @@index([postId])
  @@index([parentId])
  @@map("community_comments")
}

model CommunityCommentLike {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  emoji     String   @default("like")
  createdAt DateTime @default(now()) @map("created_at")

  comment CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("community_comment_likes")
}

model CommunityPostLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  emoji     String   @default("like")
  createdAt DateTime @default(now()) @map("created_at")

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("community_post_likes")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  actorId           String?  @map("actor_id")
  actorDisplayName  String?  @map("actor_display_name")
  actorAvatarUrl    String?  @map("actor_avatar_url")
  type              String
  title             String
  message           String   @db.Text
  link              String?
  read              Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("notifications")
}
