# Copy to .env and fill values. Never commit .env.

PORT=4000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Local dev (from repo root: docker compose up -d)
# DATABASE_URL="postgresql://ci:ci@127.0.0.1:5432/taqwin_ci?schema=public"
# DIRECT_URL="postgresql://ci:ci@127.0.0.1:5432/taqwin_ci?schema=public"
#
# Supabase production / shared dev:
# DATABASE_URL: pooler URL (port 6543, pgbouncer=true&connection_limit=1)
# DIRECT_URL : direct URL for migrations (port 5432)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Block A1 — MongoDB (AI-generated content)
# Stores AI-generated diet + workout plans, coach chat history, and RAG
# content (coaching book chunks, embeddings). Postgres remains the primary
# store for users, profiles, food items, exercises, and logs.
# Leave empty to disable plan persistence (the dashboard will fall back to
# formula-based targets and built-in workout templates).
# Use database name /taqwin in the URI (not the Atlas default "test").
# Production: Atlas → Network Access → allow VPS outbound IP.
# Verify: npm run verify:a1  (and GET /health → stores.mongo)
# -----------------------------------------------------------------------------
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/taqwin?retryWrites=true&w=majority
# Alias accepted by the API (same value as MONGO_URI):
# MONGODB_URI=
# Explicit DB name (required if password contains @ — otherwise driver may use "test"):
# MONGO_DB_NAME=taqwin

# Optional MongoDB Atlas Vector Search (Phase 8). Set to true and provide the
# vector index names after creating them in Atlas → Search → Create Index
# (vectorSearch type) on the listed collections + paths.
# MONGO_VECTOR_SEARCH=false
# MONGO_VECTOR_BOOK_INDEX=book_chunks_vector
# MONGO_VECTOR_FOOD_INDEX=food_embeddings_vector
# MONGO_VECTOR_EXERCISE_INDEX=exercise_embeddings_vector

# Embeddings provider (Phase 8 — used by scripts/embed-* and vector retrieval)
# EMBED_PROVIDER=openai   # one of: openai | voyage | ollama
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=pa-...
# VOYAGE_EMBED_MODEL=voyage-3-large
# OLLAMA_EMBED_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-32+char-random
JWT_EXPIRES_IN=7d
# Set to true to show email verification step after signup (default: skip, go straight to onboarding)
# Require 6-digit email code after signup (default: on when Gmail is configured)
# REQUIRE_EMAIL_VERIFICATION=false

# Google OAuth (optional). Set GOOGLE_CALLBACK_URL to your Render URL in production.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Public origin of the SPA — used for OAuth redirects and CORS (comma-separated for multiple).
# Production example: FRONTEND_URL=https://taqwin.vercel.app
FRONTEND_URL=http://localhost:3000

# Optional extra CORS origins (comma-separated), e.g. a custom domain.
# CORS_ALLOWED_ORIGINS=https://www.taqwin.com

# In production, allow any https://*.vercel.app origin (preview deploys). Set false to disable.
# CORS_ALLOW_VERCEL=true

# Optional: cap auth requests per IP per 15 minutes (default: 60 prod / 200 dev)
# AUTH_RATE_LIMIT_MAX=60
# Emergency DB token for /api/admin/emergency-migrate-role-enum
# EMERGENCY_MIGRATE_TOKEN=long-random-string

# -----------------------------------------------------------------------------
# Email (Gmail SMTP via app password)
# -----------------------------------------------------------------------------
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# -----------------------------------------------------------------------------
# Twilio Verify (SMS password reset) — https://console.twilio.com
# Trial: verify recipient numbers under Phone Numbers → Verified Caller IDs
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxx

# -----------------------------------------------------------------------------
# Supabase Storage (signed-URL uploads)
# -----------------------------------------------------------------------------
# If omitted, SUPABASE_URL is inferred from DATABASE_URL (postgres.PROJECT_REF).
# Without SERVICE_KEY, uploads use local disk at backend-node/uploads/ (dev only).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Client-safe key (optional; not used for uploads today)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Required for POST /api/uploads/sign — use service_role from Dashboard → API
SUPABASE_SERVICE_KEY=eyJ...service-role-key
SUPABASE_STORAGE_BUCKET=taqwin-uploads
# Optional: public API base for local upload URLs (default: request host)
# API_PUBLIC_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Block A5 — CAG context bundle cache (default 10 min)
# CAG_CACHE_TTL_MS=600000

# Block A3 — FastAPI bridge (taqwin-ai microservice)
# When FEATURE_AI_VIA_FASTAPI=true, POST /api/ai/chat proxies to AI_SERVICE_URL/chat.
# On failure, falls back to Node LLM (Anthropic / Gemini / Ollama below).
# Local: run `uvicorn app.main:app --port 8000` in ai-service/
# -----------------------------------------------------------------------------
# FEATURE_AI_VIA_FASTAPI=true
# AI_SERVICE_URL=http://localhost:8000
# AI_SERVICE_TIMEOUT_MS=30000

# Block A4 — internal API (FastAPI → Node tool execution; min 16 chars)
# Same value in ai-service/.env. Header: X-Internal-Key
# AI_INTERNAL_KEY=change-me-long-random-secret-min-16-chars

# -----------------------------------------------------------------------------
# Anthropic Claude (server-side proxy for every /api/ai/* route)
#   /api/ai/chat            — text coach
#   /api/ai/form-check/*    — live form tracer coaching
#   /api/ai/food/*          — multi-item food detection (Claude Vision) + nutrition
#   /api/ai/plan/*          — onboarding-driven workout + diet plan generator
#   /api/ai/notify/*        — smart notification personalization
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# AI coach chat provider: anthropic | gemini | ollama (auto: anthropic if key set, else gemini, else ollama)
# AI_PROVIDER=anthropic
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=1024

# Local dev with Ollama (npm run coach:test)
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Per-user-per-minute rate caps (defaults shown — uncomment to override).
# AI_RATE_LIMIT_MAX=20                  # /api/ai/chat
# AI_FORM_CHECK_RATE_LIMIT_MAX=60       # feedback calls during a live set
# AI_FOOD_DETECT_RATE_LIMIT_MAX=10      # vision is expensive — keep low
# AI_PLAN_RATE_LIMIT_MAX=5              # plan generation is heavy

# Legacy Gemini key — kept until the Claude swap lands so the old /api/ai/chat
# keeps working in environments that haven't been re-provisioned yet.
# GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# FatSecret Platform API (nutrition library search + import)
# Register: https://platform.fatsecret.com/register
# Whitelist server IP(s) on your API key (required for REST calls).
# -----------------------------------------------------------------------------
FATSECRET_CLIENT_ID=your-fatsecret-client-id
FATSECRET_CLIENT_SECRET=your-fatsecret-client-secret
FATSECRET_SCOPE=basic
# Optional localization (e.g. Egypt + Arabic):
# FATSECRET_REGION=EG
# FATSECRET_LANGUAGE=ar

# -----------------------------------------------------------------------------
# MuscleWiki web scrape (no API key) — exercise catalog import
#   npm run import:musclewiki
# Fix video URLs + cache ALL MuscleWiki MP4s locally (recommended):
#   npm run sync:musclewiki-videos
#   npm run sync:musclewiki-videos -- --limit=20
#   npm run sync:musclewiki-videos -- --skip-cached
# Optional API key speeds download: MUSCLEWIKI_API_KEY=mw_xxx
# Legacy cache (wrong URLs from mirror): npm run cache:exercise-videos
# Optional Playwright for live musclewiki.com crawl (Cloudflare):
#   npm install playwright && npx playwright install chromium
# -----------------------------------------------------------------------------
# MUSCLEWIKI_SCRAPE_DELAY_MS=400
# MUSCLEWIKI_API_KEY=mw_xxx   # optional — only if using legacy API video proxy

# -----------------------------------------------------------------------------
# Block A1 — Redis (optional in dev; required for CAG + BullMQ in later blocks)
# Local: docker compose up -d redis  →  REDIS_URL below
# Cloud: Upstash REST (recommended) or Upstash TCP tab
# Verify: npm run verify:a1
# -----------------------------------------------------------------------------
#
# Option A — Upstash REST (recommended for cloud / no Docker):
# UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
#
# Option B — TCP via ioredis (local Docker or Upstash TCP tab):
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_URL=rediss://default:PASSWORD@YOUR_DB.upstash.io:6379
#
# Upstash REST takes priority when both UPSTASH_* and REDIS_URL are set.
# FDC_FILTER_PAGE_BATCH=4          # USDA pages fetched in parallel per batch (default 4)
# FDC_FILTER_MAX_BATCHES=3         # max batches when filters are active (default 3 → up to 12 pages)
# FDC_PAGE_CACHE_TTL_MS=600000     # per USDA page cache (default 10 min)
# FDC_FILTERED_CACHE_TTL_MS=300000 # filtered scan cache (default 5 min)
# FDC_RESPONSE_CACHE_TTL_MS=300000 # full /fdc/search response with filters (default 5 min)
# FDC_RESPONSE_PLAIN_CACHE_TTL_MS=900000 # /fdc/search without filters (default 15 min)
# FDC_AR_CACHE_TTL_MS=900000       # Arabic overlay cache (default 15 min)
# FDC_RESOLVE_CACHE_TTL_MS=1800000 # resolved search query cache (default 30 min)
# FDC_RESOLVE_CACHE_MAX=500
# FDC_TRANSLATE_CONCURRENCY=24     # parallel EN→AR food name translations
# FDC_WARM_CACHE=true              # background warm on server start (set false to disable)
# FDC_WARM_CONCURRENCY=2           # parallel warm tasks
# FDC_WARM_GAP_MS=120              # pause between warm tasks (USDA rate limits)
# FDC_WARM_LANGS=ar                # ar, en, or ar,en
# FDC_CLIENT_CACHE_SEC=300         # Cache-Control on /fdc/search responses
# FDC_FILTER_PAGE_BATCH=2          # USDA pages per parallel batch when filters on (default 2)
# FDC_FILTER_MAX_BATCHES=2         # max batches when filters on (default 2)
# FDC_MEMORY_CACHE_MAX=400         # L1 in-process entry cap
